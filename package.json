{
  "name": "technical-learning-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @tlp/web",
    "dev:api": "npm run dev --workspace @tlp/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "verify": "bash scripts/verify-wave1.sh",
    "health": "bash scripts/local-health-check.sh",
    "security:scan": "bash scripts/security-scan.sh",
    "smoke:api": "bash scripts/smoke-api.sh",
    "admin:provision-founder": "npm run provision-founder --workspace @tlp/api",
    "verify:wave6-batch10": "bash scripts/verify-wave6-batch10.sh",
    "test:wave6-batch10": "tsx --test tests/wave6-batch10/lab-provider-rollout.w6b10.test.ts tests/wave6-batch10/lab-provider-selection.w6b10.test.ts tests/wave6-batch10/lab-session-lifecycle.w6b10.test.ts tests/wave6-batch10/lab-integration-wiring.w6b10.test.ts"
  },
  "engines": {
    "node": ">=22"
  }
}

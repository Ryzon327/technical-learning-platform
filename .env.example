# Technical Learning Platform — local development template
# Copy to .env.local for local development. Never commit real secrets.

APP_ENV=development
APP_NAME=Technical Learning Platform
APP_VERSION=0.1.0
GIT_COMMIT_SHA=local
BUILD_TIME=local
API_PORT=3001

# Web
VITE_APP_NAME=Technical Learning Platform
VITE_API_BASE_URL=http://localhost:3001

# Supabase — public browser values only use VITE_ prefix.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side Supabase configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# One-time Founder/admin bootstrap inputs.
# Set only in the operator shell when intentionally provisioning the Founder.
FOUNDER_BOOTSTRAP_USER_ID=
FOUNDER_BOOTSTRAP_CONFIRM=

# AI Gateway — provider secrets are server-only
AI_DEFAULT_PROVIDER=mock
AI_LOCAL_BASE_URL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Observability
SENTRY_DSN=
# Container Lab Provider — disabled unless explicitly enabled.
TLP_CONTAINER_PROVIDER_ENABLED=false
TLP_CONTAINER_RUNTIME_BINARY=docker
TLP_CONTAINER_DEFAULT_IMAGE=
TLP_CONTAINER_ALLOWED_IMAGES=
TLP_CONTAINER_MAX_SESSIONS=10
TLP_CONTAINER_CPU_LIMIT=1
TLP_CONTAINER_MEMORY_MB=512
TLP_CONTAINER_PIDS_LIMIT=128
TLP_CONTAINER_TMPFS_MB=64
TLP_CONTAINER_COMMAND_TIMEOUT_MS=10000

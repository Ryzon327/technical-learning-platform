# Technical Learning Platform — local development template
# Copy to .env.local for local development. Never commit real secrets.

APP_ENV=development
APP_NAME=Technical Learning Platform
APP_VERSION=0.1.0
GIT_COMMIT_SHA=local
BUILD_TIME=local
API_PORT=3001

# Web
VITE_APP_NAME=Technical Learning Platform
VITE_API_BASE_URL=http://localhost:3001

# Supabase — public browser values only use VITE_ prefix.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only Supabase configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI Gateway — provider secrets are server-only
AI_DEFAULT_PROVIDER=mock
AI_LOCAL_BASE_URL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Observability
SENTRY_DSN=
